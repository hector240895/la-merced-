# Copia este archivo como .env.local y llena los valores en TU computadora.
# .env.local nunca se sube a GitHub (está en .gitignore). No pegues estos
# valores en el chat.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://yayksvcwxrkomqbeafla.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (es pública: va en la app)
SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → Secret key (PRIVADA: solo para los
# scripts de instalación; nunca va en la app ni en GitHub)
SUPABASE_SECRET_KEY=

# Dominio interno de los correos de acceso (usuario@lamerced.local)
DOMINIO_USUARIOS=lamerced.local
